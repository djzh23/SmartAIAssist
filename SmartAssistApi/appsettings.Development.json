{
  "ConnectionStrings": {
    "Supabase": ""
  },
  "DatabaseFeatures": {
    "PostgresEnabled": false,
    "ChatNotesStorage": "redis",
    "JobApplicationsStorage": "redis",
    "CareerProfileStorage": "redis",
    "ChatSessionStorage": "redis",
    "LearningMemoryStorage": "redis",
    "TokenUsageStorage": "redis",
    "UsageStorage": "redis"
  },
  "Embeddings": {
    "Provider": "onnx",
    "ModelPath": "Models/model.onnx",
    "VocabPath": "Models/vocab.txt",
    "Dimension": 384,
    "MaxSequenceLength": 128,
    "IntraOpThreads": 2,
    "InterOpThreads": 1
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
